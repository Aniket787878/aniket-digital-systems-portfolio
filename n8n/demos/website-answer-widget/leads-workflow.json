      "name": "Check and tidy the lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Plain text only, short fields, a phone number with 8 to 15 digits.\n// Anything else is rejected before it reaches the sheet.\nconst b = $input.first().json.body || {};\nconst txt = (v, n) => String(v ?? \"\").replace(/[<>]/g, \"\").replace(/\\s+/g, \" \").trim().slice(0, n);\nconst name = txt(b.name, 80);\nconst phone = String(b.phone ?? \"\").replace(/[^0-9+]/g, \"\").slice(0, 16);\nconst digits = phone.replace(/\\D/g, \"\").length;\nconst valid = name.length >= 2 && digits >= 8 && digits <= 15;\nreturn [{ json: { valid, name, phone, question: txt(b.question, 300), page: txt(b.page, 120) } }];"
      }
    },
    {
      "id": "6f7df06e-9051-402a-8127-a3a1e9896967",
      "name": "Valid lead?",
      "type": "n8n-nodes-base.if",
