        "emailType": "text",
        "message": "{{ $json.name }} ({{ $json.email }}) from {{ $json.company || 'no company given' }}\nBudget: {{ $json.budget_band }}\nSource: {{ $json.source }}\n\nWorkflow they want automated:\n---\n{{ $json.workflow_broken }}\n---\n\nReply within 24h. Airtable row created.",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail_aniket",
          "name": "gmail_aniket"
        }
      },
      "id": "8c9d4e5f-6a7b-4c8d-9e0f-a1b2c3d4e5f6",
      "name": "Notify Aniket",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [660, 180],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "Got your note — I'll reply within 24h",
        "emailType": "text",
        "message": "Hey {{ $json.name.split(' ')[0] }},\n\nGot your message. I'll read it properly and reply within 24 hours.\n\nQuick note: I only take on projects I'm confident I can genuinely help with, so if what you sent me isn't the right fit, I'll say that too — and try to point you somewhere useful.\n\nIn the meantime, if you want to see what I've built before: https://[your-domain]/projects\n\n— Aniket\nDigital Systems Builder",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail_aniket",
          "name": "gmail_aniket"
        }
      },
      "id": "9d0e5f6a-7b8c-4d9e-af01-b2c3d4e5f6a7",
      "name": "Auto-reply Sender",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [660, 420],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const lead = $node['Airtable'].json;\nconst incoming = $input.all();\n\nconst hasWarning = incoming.some((item) => {\n  const j = item && item.json;\n  return Boolean((j && (j.error || j.errorMessage)) || (item && item.error));\n});\n\nconst response = { status: 'ok', lead_id: lead.id };\nif (hasWarning) {\n  response.warning = 'One or more Gmail notifications failed; lead still recorded.';\n}\n\nreturn [response];"
      },
      "id": "0e1f6a7b-8c9d-4eaf-0b12-c3d4e5f6a7b8",
      "name": "Respond",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    }
  ],
