{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/lead",
      "destination": "https://n8n.mindsetwellness.in/webhook/portfolio-leads"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
