{
  "name": "Portfolio lead intake (Sheets + Gmail)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aniket-leads",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "71bce8b4-6d51-46d0-9446-cf7768b6735f",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "c55c1e84-d5ed-4a4a-9b79-ef05f5774627"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "6583e1df-707d-48e8-b4fa-574dc8004f51",
              "name": "Submitted At",
              "value": "={{ $json.body.submitted_at || $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "0e968f40-de32-4df7-8732-31368d7a1476",
              "name": "Name",
              "value": "={{ ($json.body.name || '').trim() }}",
              "type": "string"
            },
            {
              "id": "d19b3ba7-cdb8-4c4c-9b3b-f2027eb56953",
              "name": "Email",
              "value": "={{ ($json.body.email || '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "429f6dbc-1454-473c-ade0-f14893fa0327",
              "name": "Company",
              "value": "={{ ($json.body.company || '').trim() }}",
              "type": "string"
            },
            {
              "id": "480fd03a-395e-48ae-b1bc-21ba27e4eb03",
              "name": "Workflow",
              "value": "={{ ($json.body.workflow_broken || '').trim() }}",
              "type": "string"
            },
            {
              "id": "cffa7cce-bbdf-4c32-9a44-83b73ff9f146",
              "name": "Budget",
              "value": "={{ $json.body.budget_band || 'not_sure' }}",
              "type": "string"
            },
            {
              "id": "bc986701-52d0-43e3-b90b-18e24a392c67",
              "name": "Source",
              "value": "={{ $json.body.source || 'direct' }}",
              "type": "string"
            },
            {
              "id": "9e4be1be-d87f-4ae4-b38c-f64870569ca6",
              "name": "Stage",
              "value": "New",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b56860c7-2460-4e03-a531-d33dadd5fa00",
      "name": "Clean fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "df095456-5b9e-4a3e-a1bf-82eaefad042d",
              "leftValue": "={{ $json.Name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "cd47ba3c-bacc-40a7-ab9d-949f4b9aabdb",
              "leftValue": "={{ $json.Email }}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "32ae92ba-7576-4378-a30c-dad30e36c170",
              "leftValue": "={{ $json.Workflow.length }}",
              "rightValue": 20,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6f90c1e9-5e64-4080-b68b-9c3af3494832",
      "name": "Validate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":400,\"error\":\"missing_required_fields\"}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "7ad60728-52cd-4920-8d4f-e9e4da75477a",
      "name": "Reject 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        460
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "Portfolio leads"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "Leads"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets (aniket.html@gmail.com)"
        }
      },
      "id": "1feba633-623e-4bc0-9583-aaea8a849e37",
      "name": "Add to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "sendTo": "aniket.html@gmail.com",
        "subject": "=New lead: {{ $('Clean fields').item.json.Name }} ({{ $('Clean fields').item.json.Budget }})",
        "emailType": "text",
        "message": "={{ $('Clean fields').item.json.Name }} <{{ $('Clean fields').item.json.Email }}>\nCompany: {{ $('Clean fields').item.json.Company || 'not given' }}\nBudget: {{ $('Clean fields').item.json.Budget }}\nSource: {{ $('Clean fields').item.json.Source }}\n\nWhat they want fixed:\n{{ $('Clean fields').item.json.Workflow }}\n\nSaved to the Portfolio leads sheet. Reply within 24 hours.",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $('Clean fields').item.json.Email }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail (aniket.html@gmail.com)"
        }
      },
      "id": "f1f4c63a-340e-4baf-b147-f9e69ee151e1",
      "name": "Alert Aniket",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Clean fields').item.json.Email }}",
        "subject": "Got your message, I'll reply within 24 hours",
        "emailType": "text",
        "message": "=Hi {{ $('Clean fields').item.json.Name.split(' ')[0] }},\n\nThanks for getting in touch. I've got your note about:\n\n\"{{ $('Clean fields').item.json.Workflow.slice(0, 280) }}\"\n\nI'll read it properly and reply within 24 hours, usually sooner. If it isn't something I can genuinely help with, I'll tell you that too.\n\nIn the meantime, here's some of the work: https://aniket-portfolio-six-bice.vercel.app/projects\n\nAniket\nhttps://aniket-portfolio-six-bice.vercel.app",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail (aniket.html@gmail.com)"
        }
      },
      "id": "3cbb42e1-52c6-457e-859f-9a6bc1d254fb",
      "name": "Auto-reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1100,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"ok\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "f594297d-c66e-470e-bb63-bb18ace4a900",
