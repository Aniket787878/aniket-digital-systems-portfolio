            "Source": "={{ $json.source }}",
            "Submitted At": "={{ $json.submitted_at }}",
            "Stage": "Engaged"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": true,
          "convertFieldsToString": true
        }
      },
