                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "email-looks-valid",
              "leftValue": "={{ $json.email }}",
              "rightValue": "/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/",
              "operator": {
